# Copy this file to .env; never commit real credentials.
# Required for summarization/chat, or enter a key in the local web settings.
MIMO_API_KEY=
# Defaults used by config.py:
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Paste the generated value below before starting the app.
SECRET_KEY=
